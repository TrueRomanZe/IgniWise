# IgniWise - Variables de Entorno
# Copia este archivo como .env y rellena tus API keys

# ============================================================
# OBLIGATORIO
# ============================================================

# OpenWeatherMap API
# Obtén tu key gratis en: https://openweathermap.org/api
OPENWEATHER_API_KEY=tu_api_key_aqui

# ============================================================
# CONFIGURACIÓN DEL MODELO (opcional, valores por defecto)
# ============================================================

RF_N_ESTIMATORS=200
RF_MAX_DEPTH=15
RANDOM_SEED=42

# ============================================================
# CONFIGURACIÓN DE PREDICCIONES (opcional, valores por defecto)
# ============================================================

FORECAST_DAYS=7
CONFIDENCE_THRESHOLD=0.75

# ============================================================
# AUTOMATIZACIÓN (opcional, valores por defecto)
# ============================================================

UPDATE_FREQUENCY_HOURS=6
RETRAIN_FREQUENCY_HOURS=24

# ============================================================
# LOGGING (opcional)
# ============================================================

LOG_LEVEL=INFO
